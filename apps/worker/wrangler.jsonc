{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softween-live-checker-api",
  // account_id comes from the CLOUDFLARE_ACCOUNT_ID env var (CI) or wrangler login (local)
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-02-08",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "live-checker-db",
      "database_id": "93782ce8-a134-4f88-94cd-5ab0cd413533"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "f3f3b9d190b34444bb4633bf03771f1d"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Secrets (set via `wrangler secret put`):
  //   JWT_SECRET          - HMAC secret for auth tokens
  //   GMAIL_CLIENT_EMAIL  - Google service account email
  //   GMAIL_PRIVATE_KEY   - RSA private key (PEM, with \n escaped)
  //   GMAIL_SENDER_EMAIL  - delegated sender address
  //   SENTRY_DSN          - optional, leave unset to disable error reporting
  "vars": {
    "ENVIRONMENT": "production",
    "FRONTEND_URL": "https://livedetector.softween.com",
    "SENTRY_RELEASE": "softween-live-detector@0.0.1"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softween-live-checker-api",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-02-08",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "live-checker-db",
      "database_id": "93782ce8-a134-4f88-94cd-5ab0cd413533"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "f3f3b9d190b34444bb4633bf03771f1d"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "FRONTEND_URL": "https://livedetector.softween.com"
  },
  "routes": [
    {
      "pattern": "api.livedetector.softween.com/*",
      "zone_name": "softween.com"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
